<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.spc</groupId><artifactId>uiptv</artifactId><version>1.0.0</version>
        <relativePath>../../../pom.xml</relativePath>
    </parent>
    <artifactId>uiptv-epg-builder-bin</artifactId>
    <packaging>pom</packaging>
    <name>UIPTV EPG Builder Native Package</name>
    <properties>
        <epg.native.skip>true</epg.native.skip>
        <epg.native.target>none</epg.native.target>
        <epg.python>python3</epg.python>
    </properties>
    <!-- Reactor ordering guarantees that the shaded bridge is ready before freezing Python. -->
    <dependencies>
        <dependency><groupId>com.spc</groupId><artifactId>epg-bridge</artifactId><version>${project.version}</version></dependency>
    </dependencies>
    <build><plugins><plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions><execution>
            <id>package-native-epg-builder</id><phase>package</phase><goals><goal>run</goal></goals>
            <configuration>
                <skip>${epg.native.skip}</skip>
                <target>
                    <exec executable="${epg.python}" failonerror="true">
                        <arg value="${project.basedir}/packaging/build_native.py"/>
                        <arg value="--target"/><arg value="${epg.native.target}"/>
                        <arg value="--version"/><arg value="${project.version}"/>
                        <arg value="--java-home"/><arg value="${java.home}"/>
                        <arg value="--bridge"/><arg value="${project.basedir}/../../../epg-bridge/target/epg-bridge-${project.version}.jar"/>
                        <arg value="--output"/><arg value="${project.build.directory}"/>
                    </exec>
                </target>
            </configuration>
        </execution></executions>
    </plugin></plugins></build>
    <profiles>
        <profile>
            <id>mac-aarch64</id>
            <properties>
                <epg.native.target>mac-aarch64</epg.native.target>
                <epg.python>python3</epg.python>
            </properties>
        </profile>
        <profile>
            <id>mac-x86_64</id>
            <properties>
                <epg.native.target>mac-x86_64</epg.native.target>
                <epg.python>python3</epg.python>
            </properties>
        </profile>
        <profile>
            <id>windows-x86_64</id>
            <properties>
                <epg.native.target>windows-x86_64</epg.native.target>
                <epg.python>python</epg.python>
            </properties>
        </profile>
        <profile>
            <id>windows-aarch64</id>
            <properties>
                <epg.native.target>windows-aarch64</epg.native.target>
                <epg.python>python</epg.python>
            </properties>
        </profile>
        <profile>
            <id>windows-amd64</id>
            <properties>
                <epg.native.target>windows-x86_64</epg.native.target>
                <epg.python>python</epg.python>
            </properties>
        </profile>
        <profile>
            <id>linux-x86_64</id>
            <properties>
                <epg.native.target>linux-x86_64</epg.native.target>
                <epg.python>python3</epg.python>
            </properties>
        </profile>
        <profile>
            <id>linux-aarch64</id>
            <properties>
                <epg.native.target>linux-aarch64</epg.native.target>
                <epg.python>python3</epg.python>
            </properties>
        </profile>
        <profile>
            <id>linux-amd64</id>
            <properties>
                <epg.native.target>linux-x86_64</epg.native.target>
                <epg.python>python3</epg.python>
            </properties>
        </profile>
    </profiles>
</project>
