<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spc</groupId>
        <artifactId>uiptv</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>uiptv-shared</artifactId>
    <name>UIPTV Shared Contracts</name>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <!--
              The baseline SQL is the schema artifact every platform shares: core loads it from the
              classpath, the Android app repackages it as an asset, and UiptvSchemaTest reads it to verify
              this module's declared columns instead of trusting a second hand-maintained copy.
            -->
            <testResource>
                <directory>${project.basedir}/../core/src/main/resources</directory>
            </testResource>
        </testResources>
    </build>
</project>
