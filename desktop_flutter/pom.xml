<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.spc</groupId>
        <artifactId>uiptv</artifactId>
        <version>1.1.5</version>
    </parent>

    <artifactId>uiptv-desktop-flutter</artifactId>
    <packaging>pom</packaging>
    <name>UIPTV Flutter Desktop</name>

    <properties>
        <uiptv.flutter.build.target>macos</uiptv.flutter.build.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>flutter-pub-get</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>pub</argument>
                                <argument>get</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dart-format-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>dart</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>format</argument>
                                <argument>--output=none</argument>
                                <argument>--set-exit-if-changed</argument>
                                <argument>lib</argument>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-analyze</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>analyze</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>test</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>flutter-native-build</id>
                        <phase>package</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>flutter</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>build</argument>
                                <argument>${uiptv.flutter.build.target}</argument>
                                <argument>--release</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>desktop-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <uiptv.flutter.build.target>macos</uiptv.flutter.build.target>
            </properties>
        </profile>
        <profile>
            <id>desktop-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <uiptv.flutter.build.target>windows</uiptv.flutter.build.target>
            </properties>
        </profile>
        <profile>
            <id>desktop-linux</id>
            <activation>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <properties>
                <uiptv.flutter.build.target>linux</uiptv.flutter.build.target>
            </properties>
        </profile>
    </profiles>
</project>
